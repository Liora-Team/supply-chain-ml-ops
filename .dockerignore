# Keep the build context tiny + the image clean.
.venv/
.git/
.github/
__pycache__/
**/__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Not needed by any image target (scripts/ stays in: the training target runs it)
tests/
docs/
pages/
app.py
data/
*.pdf
*.md
.env
.env.*
.DS_Store

# DVC internals: cache/ alone is ~233 MB of build context, and config.local holds the
# DagsHub token. No target COPYs them — keep them out of the context entirely.
.dvc/

# Weights restored by `make pull`; the API image only needs the classical pipelines
models/distilbert_*/