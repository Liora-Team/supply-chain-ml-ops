# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.so

# ---- Virtual environments / uv ----
.venv/
venv/
env/
.python-version.local
# NOTE: keep `uv.lock` committed — it is what pins identical deps for the whole team.

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Data ----
# Large / generated splits are versioned with DVC from Phase 2 — not committed to git.
data/raw/
data/processed/*.csv
data/processed/*.npz
data/processed/*.npy
data/processed/*.parquet
# small committed EDA sample (53 KB) — re-included (gitignore has no inline comments!)
!data/processed/eda_sample.parquet
# Also committed (small runtime artifact): eda_summary.json.

# ---- Models ----
# Large weights go via DVC / HF hub — never committed. DistilBERT weights are 255 MB+.
models/distilbert_*/
models/**/*.safetensors
models/**/*.bin
# the 64 MB RandomForest 5-class (excluded from migration; guard against re-adding)
models/pipelines/RandomForest*5-class.joblib
# The small sklearn pipelines (models/pipelines/*.joblib + *.json) and metric sidecars
# (models/checkpoints/*.json) ARE committed so the API + tests run from a clean clone.

# ---- Experiment tracking (MLflow, Phase 2) ----
mlflow.db
mlruns/
mlartifacts/

# ---- Notebooks (this project intentionally excludes notebooks) ----
*.ipynb
.ipynb_checkpoints/

# ---- Course material (kept locally, not committed) ----
*.pdf

# ---- Testing / coverage ----
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---- OS / editors ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
