# Copy to `.env` and fill in as needed. `.env` is gitignored.

# --- DistilBERT model sources (Phase 2) ---
# Leave BLANK to run classical-only (the default; no torch required).
# Weights are DVC-tracked at models/distilbert_{3,5}class/final/ and restored by `make pull`
# (the registry's default location). Set only to override with a custom local path.
DISTILBERT_3CLASS=
DISTILBERT_5CLASS=

# --- Inference API ---
# Default classical model id per schema. Blank = registry picks the best macro-F1.
DEFAULT_MODEL_3CLASS=
DEFAULT_MODEL_5CLASS=

# --- MLflow tracking (DagsHub, Phase 2) ---
# DagsHub-hosted MLflow endpoint of the team repo (the repo URL + `.mlflow` suffix).
# Unset ⇒ tools fall back to a local ./mlruns directory.
MLFLOW_TRACKING_URI=
# DagsHub username.
MLFLOW_TRACKING_USERNAME=
# DagsHub personal access token (acts as the password). Never commit the real value.
MLFLOW_TRACKING_PASSWORD=
