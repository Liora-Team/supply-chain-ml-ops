# Copy to `.env` and fill in as needed. `.env` is gitignored.

# --- DistilBERT model sources (Phase 2) ---
# Leave BLANK to run classical-only (the default; no torch required).
# Set to a Hugging Face hub id (e.g. your-org/trustpilot-distilbert-3class) or a local path.
DISTILBERT_3CLASS=
DISTILBERT_5CLASS=

# --- Inference API ---
# Default classical model id per schema. Blank = registry picks the best macro-F1.
DEFAULT_MODEL_3CLASS=
DEFAULT_MODEL_5CLASS=
