# Copy to `.env` and fill in as needed. `.env` is gitignored.

# --- DistilBERT model sources (Phase 2) ---
# Leave BLANK to run classical-only (the default; no torch required).
# Weights are DVC-tracked at models/distilbert_{3,5}class/final/ and restored by `make pull`
# (the registry's default location). Set only to override with a custom local path.
DISTILBERT_3CLASS=
DISTILBERT_5CLASS=

# --- Inference API ---
# Default classical model id per schema. Blank = registry picks the best macro-F1.
DEFAULT_MODEL_3CLASS=
DEFAULT_MODEL_5CLASS=

# --- MLflow tracking and production model serving (DagsHub, Phase 2) ---
# DagsHub-hosted MLflow endpoint of the team repo (the repo URL + `.mlflow` suffix).
# When set, the API tries to serve the model referenced by the `production` alias.
# When unset, or if registry loading fails, the API serves the configured local joblib default.
MLFLOW_TRACKING_URI=

# Required when authenticating with the remote DagsHub MLflow registry.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Orchestration (Airflow, Card 3.1) ---
# DagsHub personal access token (DagsHub → Settings → Tokens). The airflow container maps
# it to AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY so the DAG's `dvc push` can reach the
# DagsHub S3 remote. Compose reads `.env` for ${...} interpolation automatically, same as
# the MLFLOW_* vars above. On the host, `dvc remote modify --local` (CONTRIBUTING.md §7)
# remains the normal route.
DAGSHUB_TOKEN=

# --- API security (Card 3.3, JWT) ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-change-me-openssl-rand-hex-32
RATE_LIMIT_PER_MINUTE=60

# Grafana admin login (Card 4.2). Required — docker compose refuses to start without it.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Drift monitoring (Card 4.1) ---
# All of these have working defaults baked into the code (docs/adr/005-drift-signal-format.md);
# override only if you need to.

MONITORING_DB_PATH=
REFERENCE_DATA_DIR=
DRIFT_STATUS_PATH=
DRIFT_REPORTS_DIR=
DRIFT_WINDOW_HOURS=24
DRIFT_MAX_ROWS=500
DRIFT_MIN_ROWS=50
REQUEST_STORE_RETENTION_DAYS=30

# --- Automated retraining control loop (Card 4.4) ---
# The loop polls the Card 4.1 drift flag and triggers the existing model
# pipeline only under a persistent cooldown/dedupe guard (never bypasses the
# Card 3.2 promotion gate). Lower COOLDOWN and POLL for a fast live demo.
RETRAIN_SCHEMAS=3-class
RETRAIN_CATEGORIES="Education & Training,Sports,Shopping & Fashion,Health & Medical"
RETRAIN_COOLDOWN_HOURS=24
RETRAIN_STALE_AFTER_HOURS=48
RETRAIN_POLL_MINUTES=15
MONITORING_DIR=/app/monitoring
